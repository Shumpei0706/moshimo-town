# Local mock is the default. Live usage requires explicit authorization and budget review.
AI_MODE=mock
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_MAX_CALLS=20
PORT=4318
# Default remains local. Public live requires production + TLS reverse proxy.
HOST=127.0.0.1
PUBLIC_ORIGIN=
ACCESS_USER=
ACCESS_PASSWORD=
# Absolute path on persistent local storage; initialize once with budget-init.mjs.
META_BUDGET_FILE=
# Optional metadata-only usage log on persistent storage.
META_USAGE_LOG=
